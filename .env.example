# Runtime modes default to static demo behavior.
FAMILY_LIFE_ADMIN_AUTH_MODE="demo"
FAMILY_LIFE_ADMIN_PERSISTENCE_MODE="static"

# Clerk keys are required only after auth mode is changed to clerk.
# Provision real values through Vercel; never commit them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"

# PostgreSQL connection for Prisma-backed persistence.
# Do not commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Private Cloudflare R2 source storage. Server-only.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="family-life-admin-production"

# Cloudflare Workers AI document conversion, OCR, and speech recognition. Server-only.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_API_TOKEN=""

# Private inbound household email. Server-only.
EMAIL_ALIAS_SECRET=""
EMAIL_WEBHOOK_SECRET=""
EMAIL_INTAKE_DOMAIN="intake.grovekind.com"

# Internal maintenance and notification dispatch authorization. Server-only.
CRON_SECRET=""

# One-time initial household seed inputs. Supply these only to the controlled seed command.
# Do not retain them as public client variables or commit real values.
LIFE_ADMIN_INITIAL_CLERK_SUBJECT=""
LIFE_ADMIN_INITIAL_USER_EMAIL=""
LIFE_ADMIN_INITIAL_USER_NAME=""
LIFE_ADMIN_INITIAL_HOUSEHOLD_NAME=""
LIFE_ADMIN_INITIAL_HOUSEHOLD_TIMEZONE="Australia/Brisbane"
LIFE_ADMIN_INITIAL_MEMBER_NAME=""
