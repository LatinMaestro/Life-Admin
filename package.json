{
  "name": "family-life-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/check-production-activation.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "tsc --noEmit",
    "guardrails:payment-source": "node scripts/check-payment-source-guardrails.mjs",
    "guardrails:mobile-api": "node scripts/check-mobile-api-boundaries.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "guardrails:static-data-boundary": "node scripts/check-static-data-boundaries.mjs",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "guardrails:migration": "node scripts/check-initial-migration.mjs",
    "check:activation": "node scripts/check-production-activation.mjs",
    "check:activation:live": "node scripts/check-production-activation.mjs --require-live",
    "db:seed:initial": "node scripts/seed-initial-household.mjs",
    "postinstall": "prisma generate",
    "db:baseline:production": "node scripts/baseline-production-migrations.mjs",
    "guardrails:recurrence-migration": "node scripts/check-recurrence-migration.mjs",
    "test:recurrence": "node --test tests/recurrence-engine.test.mjs",
    "guardrails:source-asset-migration": "node scripts/check-source-asset-migration.mjs",
    "test:source-files": "node --test tests/source-file-policy.test.mjs",
    "guardrails:email-intake-migration": "node scripts/check-email-intake-migration.mjs",
    "test:email-intake": "node --test tests/email-intake-crypto.test.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "7.5.16",
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-neon": "7.8.0",
    "@prisma/client": "7.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.23.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "postal-mime": "2.7.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3"
  }
}
