{
  "expo": {
    "name": "Family Life Admin",
    "slug": "family-life-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "familylifeadmin",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.latinmaestro.familylifeadmin",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.latinmaestro.familylifeadmin",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    }
  }
}
