{
  "expo": {
    "name": "Family Life Admin",
    "slug": "family-life-admin",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "familylifeadmin",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    }
  }
}
